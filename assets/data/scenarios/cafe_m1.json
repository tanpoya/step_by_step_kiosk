{
  "scenarioId": "cafe_m1",
  "store": "cafe",
  "title": "따뜻한 아메리카노 1잔, 매장에서 마시기",
  "steps": [
    {
      "id": "start",
      "screen": "kiosk_start",
      "guide": "매장에서 드실지, 포장하실지 골라 주세요",
      "expect": "start:dinein",
      "hint": "오늘은 '매장'을 눌러 보세요"
    },
    {
      "id": "menu",
      "screen": "menu",
      "guide": "'아메리카노'를 눌러 보세요",
      "expect": "menu:americano",
      "hint": "커피 탭 첫째 줄 왼쪽에 있어요"
    },
    {
      "id": "temp",
      "screen": "option",
      "guide": "따뜻한 음료를 고르세요",
      "expect": "opt:temp=hot",
      "hint": "'HOT'이 따뜻한 음료예요"
    },
    {
      "id": "size",
      "screen": "option",
      "guide": "작은 사이즈 'S'를 골라 주세요",
      "expect": "opt:size=S",
      "hint": "S는 작은 컵이에요. 이미 골라져 있어도 한 번 눌러 확인해요"
    },
    {
      "id": "add",
      "screen": "option",
      "guide": "'담기'를 눌러 장바구니에 넣어 주세요",
      "expect": "opt:add",
      "hint": "화면 아래 파란 '담기' 버튼이에요"
    },
    {
      "id": "cart",
      "screen": "cart",
      "guide": "주문 내용을 확인하고 '카드 결제하기'를 눌러 주세요",
      "expect": "cart:pay",
      "hint": "아메리카노 1잔이 맞는지 보고 아래 버튼을 눌러요"
    },
    {
      "id": "insert",
      "screen": "payment",
      "guide": "카드를 꽂아 주세요",
      "expect": "pay:insert",
      "hint": "화면의 카드 그림을 눌러 보세요. 실제 결제는 되지 않아요"
    },
    {
      "id": "done",
      "screen": "payment",
      "guide": "주문번호를 확인하고 '확인'을 눌러 주세요",
      "expect": "done:ok",
      "hint": "주문번호가 불리면 음료를 받으면 돼요"
    }
  ]
}
